      "title": "03 / Crossing campus",
      "location": "Glazed entrance",
      "purpose": "Cross exposed space, isolate threats and recover the relay."
    },
    {
      "id": "power",
      "title": "04 / Power returns",
      "location": "Security substation",
      "purpose": "Install both components and restore the evacuation circuit."
    },
    {
