    ],
    "yaw_degrees": 180.0,
    "dialogue": [
      "Keep your voice down. I am Shaun; I have people sheltering by the Auditorium.",
      "The emergency circuit failed and the main gate has no power. We cannot leave through it yet.",
      "Reception has a Main Breaker Fuse. The Control Bus Relay is by the glazed entrance. Bring both to the Security Substation.",
      "There is a field workbench near Reception. Scrap can buy protection or a larger magazine. Pick what helps you survive the route.",
      "Come back after the circuit is live. We need to know the exit is safe before anyone moves."
    ],
    "dialogue_after_power": [
      "The emergency line is live. I have the last group sheltered inside.",
      "The brute is blocking the route to the truck. Clear it before you approach the gate.",
      "Give its attack room to miss, then fire during recovery. Save a magazine for the final approach.",
      "Once the route is clear, reach the extraction truck. We will use the path you secured."
    ]
  },
